datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  avatarUrl     String?
  role          Role               @default(USER)
  tier          SubscriptionTier   @default(FREE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  resumes       Resume[]
  jobTailors    JobTailoring[]
  rateLimits    UserRateLimit[]
  subscriptions Subscription[]
}

model Resume {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String           @default("Untitled Resume")
  targetRole     String?
  summary        String?          @db.Text
  theme          String           @default("modern")
  font           String           @default("Inter")
  
  contactInfo    ContactInfo?
  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  
  atsAnalyses    ATSAnalysis[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ContactInfo {
  id         String   @id @default(cuid())
  resumeId   String   @unique
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  fullName   String
  email      String
  phone      String?
  location   String?
  website    String?
  linkedin   String?
  github     String?
}

model Experience {
  id           String    @id @default(cuid())
  resumeId     String
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company      String
  position     String
  location     String?
  startDate    String
  endDate      String?
  isCurrent    Boolean   @default(false)
  bullets      String[]  @default([])
  orderIndex   Int       @default(0)
}

model Education {
  id           String    @id @default(cuid())
  resumeId     String
  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?
  gpa          String?
  orderIndex   Int       @default(0)
}

model Skill {
  id          String   @id @default(cuid())
  resumeId    String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  category    String   @default("Technical")
  name        String
  level       Int      @default(3)
}

model Project {
  id          String   @id @default(cuid())
  resumeId    String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  link        String?
  technologies String[] @default([])
}

model Certification {
  id          String   @id @default(cuid())
  resumeId    String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name        String
  issuer      String
  issueDate   String?
}

model JobTailoring {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle        String
  companyName     String?
  jobDescription  String    @db.Text
  matchedKeywords String[]
  missingKeywords String[]
  tailoredBullets Json
  score           Int       @default(0)
  createdAt       DateTime  @default(now())
}

model ATSAnalysis {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  score          Int
  issues         Json
  parsedText     String   @db.Text
  createdAt      DateTime @default(now())
}

model UserRateLimit {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  count      Int      @default(0)
  resetAt    DateTime
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  status           String
  tier             SubscriptionTier
  currentPeriodEnd DateTime
}
